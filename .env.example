# Copy to .env and fill in locally. Never commit .env.

# Required only for Milestone 3+ LLM fallback. Model ID is never hardcoded.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OH_LLM_COST_CAP=5
OH_LLM_MAX_NAMES=500

# Identify this client on every source request.
OH_USER_AGENT=opaque-housing/0.1 (residential-ownership-research)

# Local data root. Raw extracts go under $OH_DATA_DIR/raw/<metro>/<dataset>/<date>/.
OH_DATA_DIR=data

# Insight app (`oh serve`). Published aggregates only; never point this at derived/.
OH_PUBLISHED_DIR=data/published
ADMIN_SECRET=
SESSION_SECRET=
ADMIN_GITHUB_LOGIN=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_TOKEN=
GITHUB_REPOSITORY=jermhey/opaque-housing
OH_GOLD_QUEUE=eval/gold/queue.csv
OH_SYNC_ON_BOOT=
OH_SYNC_TOKEN=
OH_GITHUB_REPO=jermhey/opaque-housing
OH_GITHUB_REF=main
OH_APP_URL=
